<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HSUI Engine"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Движок автоуклонения"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏸ Автоуворот выключен"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="260dp"
        android:layout_height="56dp"
        android:text="Запустить автоуворот"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#43A047"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/floatButton"
        android:layout_width="260dp"
        android:layout_height="56dp"
        android:text="Кнопка уворота ⚡"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"
        android:layout_marginBottom="36dp" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ Включите HSUI Engine в&#10;Настройки → Спец. возможности"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:gravity="center" />

</LinearLayout>
